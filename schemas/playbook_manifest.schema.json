{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "playbook_manifest.schema.json",
  "title": "PlaybookManifest",
  "description": "Metadata for a playbook. Lives in each playbook folder.",
  "type": "object",
  "required": [
    "schema_version",
    "created_at",
    "last_updated",
    "name",
    "version",
    "description",
    "target_type",
    "tool_dependencies",
    "playbook_dependencies",
    "depth_levels",
    "throttle",
    "confidence_threshold_for_llm",
    "author"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "name": {
      "type": "string",
      "description": "Machine-readable name matching the folder name, e.g. recon"
    },
    "version": {
      "type": "string",
      "description": "Semver playbook version, e.g. 1.0.0"
    },
    "description": {
      "type": "string"
    },
    "target_type": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["web", "network", "cloud", "mobile", "api"]
      },
      "minItems": 1
    },
    "tool_dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of CLI tools that must be present. e.g. subfinder, httpx"
    },
    "playbook_dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Playbooks that must complete before this one runs. e.g. recon"
    },
    "depth_levels": {
      "type": "object",
      "required": ["quick", "standard", "exhaustive"],
      "additionalProperties": false,
      "properties": {
        "quick": {
          "type": "object",
          "required": ["description", "estimated_duration_minutes"],
          "properties": {
            "description": { "type": "string" },
            "estimated_duration_minutes": { "type": "integer", "minimum": 1 }
          }
        },
        "standard": {
          "type": "object",
          "required": ["description", "estimated_duration_minutes"],
          "properties": {
            "description": { "type": "string" },
            "estimated_duration_minutes": { "type": "integer", "minimum": 1 }
          }
        },
        "exhaustive": {
          "type": "object",
          "required": ["description", "estimated_duration_minutes"],
          "properties": {
            "description": { "type": "string" },
            "estimated_duration_minutes": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "throttle": {
      "type": "object",
      "required": ["requests_per_second", "jitter_min_ms", "jitter_max_ms"],
      "additionalProperties": false,
      "properties": {
        "requests_per_second": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1000
        },
        "jitter_min_ms": {
          "type": "integer",
          "minimum": 0
        },
        "jitter_max_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "confidence_threshold_for_llm": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Findings with confidence >= this threshold get passed to LLM triage"
    },
    "author": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
