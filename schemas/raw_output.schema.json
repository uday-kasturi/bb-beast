{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "raw_output.schema.json",
  "title": "RawOutput",
  "description": "Normalized output from a single tool in a single run.",
  "type": "object",
  "required": [
    "schema_version",
    "created_at",
    "run_id",
    "tool_name",
    "tool_version",
    "invocation_command",
    "target",
    "started_at",
    "finished_at",
    "duration_seconds",
    "status",
    "findings",
    "errors"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "tool_name": {
      "type": "string"
    },
    "tool_version": {
      "type": "string"
    },
    "invocation_command": {
      "type": "string",
      "description": "Exact command string that was executed"
    },
    "target": {
      "type": "string",
      "description": "Primary target (domain, IP, URL) passed to the tool"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": ["success", "partial", "failed"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "evidence", "raw_output"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "description": "Finding type, e.g. subdomain, open_port, vulnerability, secret, exposure"
          },
          "url": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "ip": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "protocol": {
            "type": "string"
          },
          "evidence": {
            "type": "string",
            "description": "Human-readable summary of what was found"
          },
          "raw_output": {
            "description": "Verbatim output from the tool for this finding (string or object)"
          },
          "metadata": {
            "type": "object",
            "description": "Any additional tool-specific fields"
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string" },
          "stderr_excerpt": { "type": "string" },
          "exit_code": { "type": "integer" }
        }
      }
    }
  }
}
