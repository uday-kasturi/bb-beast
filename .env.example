# BugBounty Beast — template. Copy to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored; this template is safe to commit.

# REQUIRED: worker-tier model access (Hermes + cheap/uncensored models)
OPENROUTER_API_KEY=

# OPTIONAL: per-role model overrides (defaults live in core/models.py).
# Prefix with "cli:" to run a role on the local `claude` CLI instead of OpenRouter.
# BB_MODEL_ORCHESTRATOR=cli:claude-fable-5
# BB_MODEL_TRIAGE=nousresearch/hermes-3-llama-3.1-405b
# BB_MODEL_CRITIC=nousresearch/hermes-3-llama-3.1-70b
# BB_MODEL_EXPLOIT_SMITH=nousresearch/hermes-3-llama-3.1-405b
# BB_MODEL_VALIDATOR=nousresearch/hermes-3-llama-3.1-405b

# OPTIONAL: OpenRouter dashboard attribution
# BB_OPENROUTER_REFERER=https://localhost/bb-beast
# BB_OPENROUTER_TITLE=BugBounty Beast
